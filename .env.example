# Copy this file to .env and fill in your key. .env is git-ignored.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Leave blank to pick a model in the Profile tab
# (the app lists the models your key can use).
CLAUDE_MODEL=

# Optional. Web search tool version sent to the Claude API.
WEB_SEARCH_TOOL=web_search_20250305

# Optional. Local port (the server only listens on 127.0.0.1).
PORT=4317
