# Copy this file to .env and fill in your key. .env is git-ignored.

# Which AI backend to use: kiro or anthropic.
# If left blank, the app uses Kiro when KIRO_API_KEY is set, otherwise Anthropic.
AI_PROVIDER=kiro

# --- Kiro (default) ---
# Needs kiro-cli installed (macOS/Linux: curl -fsSL https://cli.kiro.dev/install | bash)
# Create a key at https://app.kiro.dev under API Keys (Pro plan or higher).
KIRO_API_KEY=
# Optional. Model ID such as claude-sonnet-4.6; blank uses Kiro's default.
# You can also pick one in the Profile tab.
KIRO_MODEL=
# Optional. Path to kiro-cli if it isn't on your PATH.
KIRO_CLI_PATH=
# Optional. Max seconds per kiro-cli run.
KIRO_TIMEOUT_SECS=600

# --- Anthropic (alternative) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional. Leave blank to use the newest Sonnet your key can use.
CLAUDE_MODEL=
# Optional. Web search tool version sent to the Claude API.
WEB_SEARCH_TOOL=web_search_20250305

# Optional. Local port (the server only listens on 127.0.0.1).
PORT=4317
